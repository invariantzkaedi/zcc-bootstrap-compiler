/* Tier 39GB: fast_div_10 - x / 10 via magic multiplier (Saved: 32c) */
bool ic_rule_div_10(ICtx *c) {
    Instr *it = c->it;
    int64_t k;
    if ((it->op == OP_UDIV || it->op == OP_DIV) && reg_is_const(c->fn, it->rhs, &k) && k == 10) {
        int mulhi = make_binop(c->fn, OP_MULHI, it->lhs, make_const(c->fn, it->type, 0x999999999999999AULL, it));
        rewrite_to_binop(c->fn, it, OP_SHR, mulhi, make_const(c->fn, it->type, 4, it));
        return true;
    }
    return false;
}


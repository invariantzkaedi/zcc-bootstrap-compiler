{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "zkaedi-lab promotion record v1",
  "type": "object",
  "required": ["candidate_id","from_tier","to_tier","decision","evidence_run_ids","policy_version","signed_by","issued_at","signature"],
  "properties": {
    "candidate_id": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "from_tier": {"type":"integer","minimum":0},
    "to_tier": {"type":"integer","minimum":0},
    "decision": {"enum":["promote"]},
    "evidence_run_ids": {"type":"array","minItems":1,"items":{"type":"string","format":"uuid"}},
    "policy_version": {"type":"string"},
    "signed_by": {"type":"string"},
    "issued_at": {"type":"string"},
    "signature": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}

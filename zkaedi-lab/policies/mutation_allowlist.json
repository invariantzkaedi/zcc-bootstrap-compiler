{
  "allowed_targets": [
    "canonical_prompt",
    "tool_policy.allowed_tools",
    "tool_policy.retry_policy",
    "scaffold.steps",
    "scaffold.verification_checklist",
    "eval_config.battery",
    "eval_config.thresholds",
    "eval_config.context_routing"
  ],

  "authoring": {
    "docs": {
      "enabled": true,
      "schemaFieldHelp": [
        {
          "path": "runtime.calibrationProfiles.profiles[*].normalization.targetRms",
          "intent": "Sets average loudness target after normalization.",
          "safeRange": [
            0.12,
            0.28
          ],
          "authorTip": "Lower for calm content, higher for punchy tracks."
        },
        {
          "path": "runtime.failover.silenceAndFailureBehavior.silenceDetection.rmsThreshold",
          "intent": "Threshold below which input is treated as silence.",
          "safeRange": [
            0.006,
            0.03
          ],
          "authorTip": "Raise slightly for noisy mic environments."
        },
        {
          "path": "runtime.latencyCompensation.targetSyncOffsetMs",
          "intent": "Compensates analysis/render/display delay.",
          "safeRange": [
            -120,
            40
          ],
          "authorTip": "Negative offsets usually align visuals earlier."
        },
        {
          "path": "runtime.accessibility.profiles[*].flashFrequencyCapHz",
          "intent": "Limits high-frequency flashing.",
          "safeRange": [
            1.0,
            6.0
          ],
          "authorTip": "Use <=3Hz for sensitive-safe presets."
        }
      ],

    "foot_left": {
      "role": "foot",
      "parent": "leg_left",
      "anchor": [330, 880],
      "inheritOnly": true
    },

    "leg_right": {
      "role": "leg_bounce",
      "parent": "torso",
      "anchor": [330, 680],
      "band": "bass",
      "property": "translateY",
      "range": [0, -3]
    },

    "foot_right": {
      "role": "foot",
      "parent": "leg_right",
      "anchor": [330, 880],
      "inheritOnly": true
    },

    "pupil_left": {
      "role": "pupil_dilation",
      "parent": "head_root",
      "anchor": [525, 340],
      "band": "bass",
      "property": "scale",
      "range": [1, 1.08],
      "attackMs": 90,
      "releaseMs": 220

        "attackMs": 60,
        "releaseMs": 220
      }
    },

    "torso": {
      "role": "bass_pulse",
      "parent": "creature_root",
      "anchor": [500, 680],
      "band": "bass",
      "property": "scaleXY",
      "range": {
        "x": [1, 1.03],
        "y": [1, 0.98]
      },
      "attackMs": 70,
      "releaseMs": 240
    },

    "head_root": {
      "role": "head_nod",
      "parent": "creature_root",
      "anchor": [520, 380],
      "band": "lowMid",
      "property": "rotate",
      "range": [-2.5, 2.5],
      "attackMs": 110,
      "releaseMs": 260,
      "beatTranslateY": [-4, 3]

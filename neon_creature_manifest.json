    "ear_right": {
      "role": "ear_sway",
      "parent": "head_root",
      "anchor": [650, 420],
      "band": "mid",
      "property": "rotate",
      "range": [4, -4],
      "beatRange": [7, -2],
      "attackMs": 90,
      "releaseMs": 320
    },

    "tail_root": {
      "role": "tail_wave_root",
      "parent": "creature_root",
      "anchor": [180, 680],
      "band": "mid",
      "property": "rotate",
      "range": [-5, 5],
      "phase": 0,
      "attackMs": 110,
      "releaseMs": 280
    },

    "tail_mid": {
      "role": "tail_wave_mid",
      "parent": "tail_root",
      "anchor": [115, 755],
      "band": "mid",
      "property": "rotate",
      "range": [-7, 7],
      "phase": 0.5,
      "attackMs": 110,
      "releaseMs": 280
    },

    "tail_tip": {
      "role": "tail_wave_tip",
      "parent": "tail_mid",
      "anchor": [80, 800],
      "band": "highMid",
      "property": "rotate",
      "range": [-9, 9],
      "phase": 1,
      "attackMs": 110,
      "releaseMs": 280

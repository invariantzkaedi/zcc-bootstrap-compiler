      "parent": "creature_root",
      "anchor": [500, 500],
      "band": "full",
      "property": "opacity",
      "range": [0.35, 0.95],
      "beatBurst": 1,
      "attackMs": 65,
      "releaseMs": 260
    },

    "scale_detail": {
      "role": "detail",
      "parent": "torso",
      "anchor": [500, 680],
      "inheritOnly": true
    },

    "highlight_detail": {
      "role": "detail",
      "parent": "head_root",
      "anchor": [520, 380],
      "inheritOnly": true
    },

    "fx_particles": {
      "role": "particles",
      "parent": "creature_root",
      "anchor": [500, 900],
      "enabledByDefault": false,
      "maxActive": 12,
      "trigger": "strongBeat"
    }

          ]
        },
        {
          "name": "accessibility_profile_usage",
          "fields": [
            "profileId",
            "sessionDurationMs",
            "switchCount"
          ]
        },
        {
          "name": "degradation_ladder_trigger",
          "fields": [
            "triggerReason",
            "stepEntered",
            "durationMs",
            "recovered"
          ]
        }
      ],
      "dashboards": {
        "recommended": [
          "sync_health_over_time",
          "constraint_violations_by_device",
          "fallback_activation_rate",
          "profile_performance_comparison",
          "accessibility_adoption"
        ]
      },
      "closedLoopTuning": {
        "enabled": true,
        "cadence": "weekly",
        "autoSuggestParameterAdjustments": true,
        "suggestionBounds": {
          "attackMsDeltaMax": 10,
          "releaseMsDeltaMax": 40,
          "thresholdDeltaMax": 0.05,
          "amplitudeScaleDeltaMax": 0.15
        },
        "humanApprovalRequired": true
      }
    }

{
  "schema": "zkaedi.audio_sprite.v1.1",
  "spriteId": "neon-creature-runtime",
  "viewBox": [0, 0, 1000, 1000],
  "transparentBackground": true,
  "coordinateSpace": "svg-viewbox",

  "fit": {
    "mode": "contain",
    "paddingPercent": 10,
    "preserveAspectRatio": "xMidYMid meet",
    "allowNonUniformScale": false
  },

  "legacyAliases": {
    "body": "torso",
    "head": "head_root",
    "tail": "tail_root"
  },

  "joints": {
    "neck": [520, 380],
    "torso_center": [500, 680],

    "ear_left_root": [330, 340],
    "ear_right_root": [650, 420],

    "shoulder_left": [550, 680],
    "shoulder_right": [550, 680],
    "elbow_left": [550, 780],
    "elbow_right": [550, 780],
    "wrist_left": [550, 880],
    "wrist_right": [550, 880],

    "hip_left": [330, 680],
    "hip_right": [330, 680],
    "ankle_left": [330, 880],
    "ankle_right": [330, 880],

    "tail_root_joint": [180, 680],
    "tail_mid_joint": [115, 755],
    "tail_tip_joint": [80, 800],

    "eye_left_center": [525, 340],
    "eye_right_center": [525, 340],
    "pupil_left_center": [525, 340],
    "pupil_right_center": [525, 340]

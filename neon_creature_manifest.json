    "pupil_right": {
      "role": "pupil_dilation",
      "parent": "head_root",
      "anchor": [525, 340],
      "band": "bass",
      "property": "scale",
      "range": [1, 1.08],
      "attackMs": 90,
      "releaseMs": 220
    },

    "eyelid_left": {
      "role": "blink",
      "parent": "head_root",
      "anchor": [525, 340],
      "trigger": "rareBeat",
      "property": "blink",
      "durationMs": 110,
      "cooldownMs": 2200
    },

    "eyelid_right": {
      "role": "blink",
      "parent": "head_root",
      "anchor": [525, 340],
      "trigger": "rareBeat",
      "property": "blink",
      "durationMs": 110,
      "cooldownMs": 2200

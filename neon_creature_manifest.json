    "arm_left_upper": {
      "role": "arm_dance",
      "parent": "torso",
      "anchor": [550, 680],
      "band": "mid",
      "property": "rotate",
      "range": [-5, 5]
    },

    "arm_left_lower": {
      "role": "forearm_dance",
      "parent": "arm_left_upper",
      "anchor": [550, 780],
      "band": "mid",
      "property": "rotate",

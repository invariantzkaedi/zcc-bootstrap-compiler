    "failover": {
      "silenceAndFailureBehavior": {
        "silenceDetection": {
          "enabled": true,
          "rmsThreshold": 0.012,
          "durationMsToEnterSilence": 1200,
          "durationMsToExitSilence": 500,
          "hysteresis": 0.004
        },
        "confidenceModel": {
          "enabled": true,
          "inputs": [
            "beatConfidence",
            "onsetConfidence",
            "noiseFloor",
            "featureStability"
          ],
          "lowConfidenceThreshold": 0.4,
          "criticalConfidenceThreshold": 0.22
        },
        "states": [
          {
            "id": "normal",
            "enterWhen": "audioConfidence>=0.4 && !isSilent",
            "motionPolicy": {
              "reactiveGain": 1.0,
              "idleGain": 1.0,
              "fxGain": 1.0,
              "allowTransients": true,
              "allowPhraseMemory": true
            }
          },
          {
            "id": "low_confidence",
            "enterWhen": "audioConfidence<0.4 && audioConfidence>=0.22 && !isSilent",
            "motionPolicy": {
              "reactiveGain": 0.65,
              "idleGain": 1.05,
              "fxGain": 0.7,
              "allowTransients": false,
              "allowPhraseMemory": false
            }
          },
          {
            "id": "silent",
            "enterWhen": "isSilent=true",
            "motionPolicy": {
              "reactiveGain": 0.0,
              "idleGain": 1.15,
              "fxGain": 0.5,
              "allowTransients": false,
              "allowPhraseMemory": false
            },
            "idleFallbackPreset": "silence_breathing_guardian"
          },
          {
            "id": "audio_failure",
            "enterWhen": "audioStreamError=true || decoderError=true",
            "motionPolicy": {
              "reactiveGain": 0.0,
              "idleGain": 1.0,
              "fxGain": 0.4,
              "allowTransients": false,
              "allowPhraseMemory": false
            },
            "recoveryStrategy": {
              "retryIntervalMs": 2000,
              "maxRetries": 6,
              "onExhausted": "sticky_idle_mode"
            }
          }
        ],
        "transitionPolicy": {
          "crossfadeMs": 180,
          "preserveVelocity": true,
          "maxDeltaGuard": true
        }
      }
    },
    "latencyCompensation": {
      "enabled": true,
      "mode": "automatic_with_manual_offset",
      "pipelineDelaysMs": {
        "inputBuffering": 8.0,
        "fftAndFeatures": 12.0,
        "eventAggregation": 6.0,
        "renderSubmission": 10.0,
        "displayPipeline": 16.0
      },
      "estimatedTotalMs": 52.0,
      "targetSyncOffsetMs": -52.0,
      "manualTrimMs": 0.0,
      "runtimeAdaptation": {
        "enabled": true,
        "maxAdaptationPerSecondMs": 6.0,
        "stabilityWindowMs": 2400,
        "freezeDuringCriticalMoments": true
      },
      "syncValidation": {
        "enabled": true,
        "method": "beatEventCrossCorrelation",
        "windowMs": 10000,
        "acceptableErrorMs": 24.0,
        "autoRecalibrateOnFailure": true
      }
    },
    "networkSync": {
      "enabled": false,
      "mode": "authoritative_host_with_deterministic_clients",
      "clock": {
        "syncMethod": "ntp_like_smoothed_offset",
        "resyncIntervalSec": 10,
        "maxClockDriftMs": 30
      },
      "replicatedState": {
        "streamed": [
          "seed",
          "activeTier",
          "activeProfileId",
          "macro",
          "state.mode",
          "state.mood",
          "phrase.section",
          "beatEvents",
          "criticalFeatureSnapshots"
        ],
        "snapshotHz": 20,
        "eventBufferMs": 300
      },
      "determinism": {
        "requireDeterministicFloatingPointPath": true,
        "randomStreams": [
          "global",
          "gesture",
          "fx"
        ],
        "streamSeeds": {
          "global": 101,
          "gesture": 202,
          "fx": 303
        }
      },
      "packetLossPolicy": {
        "interpolateMissedFrames": true,
        "maxConsecutiveDrops": 8,
        "fallbackToLocalPredictiveMode": true
      }
    },
    "accessibility": {
      "enabled": true,
      "profiles": [
        {
          "id": "default",
          "description": "Standard accessibility baseline.",
          "motionScale": 1.0,
          "emissiveCap": 1.0,
          "flashFrequencyCapHz": 6.0,
          "highContrastAssist": false
        },
        {
          "id": "reduced_motion",
          "description": "Reduced procedural motion while preserving readability.",
          "motionScale": 0.45,
          "emissiveCap": 0.8,
          "flashFrequencyCapHz": 3.0,
          "disableTransients": true,
          "disableHighFrequencyJitter": true,
          "preferBreathingAndSlowSway": true
        },
        {
          "id": "photosensitive_safe",
          "description": "Strict anti-flicker and flash-safe profile.",
          "motionScale": 0.6,
          "emissiveCap": 0.55,
          "flashFrequencyCapHz": 2.0,
          "maxLuminanceDeltaPerFrame": 0.08,
          "forbidRapidOnOffSquarePulses": true,
          "forceEasedTransitionsMsMin": 120
        },
        {
          "id": "calm_focus",
          "description": "Low distraction mode for prolonged sessions.",
          "motionScale": 0.52,
          "emissiveCap": 0.6,
          "flashFrequencyCapHz": 2.5,
          "fxParticleDensityScale": 0.4,
          "eyeSaccadeSuppression": 0.7
        }
      ],
      "selectionPolicy": {
        "allowRuntimeSwitch": true,
        "persistPerUser": true,
        "defaultProfileId": "default"
      }
    },
    "lowConfidenceFallback": {
      "enabled": true,
      "presetLibrary": [
        {
          "id": "silence_breathing_guardian",
          "description": "Grounded idle fallback used for silence/audio outage.",
          "layers": [
            {
              "type": "breathing",
              "target": "core",
              "amplitude": 0.028,
              "periodMs": 3600
            },
            {
              "type": "hover",
              "target": "root",
              "amplitude": 3.2,
              "periodMs": 4200
            },
            {
              "type": "earSway",
              "target": "expression",
              "amplitude": 1.5,
              "periodMs": 2800
            },
            {
              "type": "glowPulse",
              "target": "ornament",
              "amplitude": 0.12,
              "periodMs": 3000
            }
          ],
          "randomness": {
            "seeded": true,
            "microVariation": 0.08
          }
        },
        {
          "id": "confident_idle_signature",
          "description": "Fallback for low-confidence but active stream.",
          "layers": [
            {
              "type": "tailWave",
              "target": "propulsion",
              "amplitude": 4.0,
              "periodMs": 1700
            },
            {
              "type": "headMicroDrift",
              "target": "expression",
              "amplitude": 1.2,
              "periodMs": 2200
            },
            {
              "type": "auraBreath",
              "target": "ornament",
              "amplitude": 0.2,
              "periodMs": 2500
            }
          ],
          "randomness": {
            "seeded": true,
            "microVariation": 0.12
          }
        }
      ],
      "entryPolicy": {
        "confidenceThreshold": 0.4,
        "silenceThreshold": 0.012,
        "crossfadeMs": 180
      }
    }
  },
  "ops": {
    "versionMigration": {
      "enabled": true,
      "manifestSchema": {
        "currentVersion": "2.0.0-legendary-maximal",
        "supportedInputVersions": [
          "1.0.0",
          "1.1.0",
          "2.0.0-compact-v2",
          "2.0.0-legendary-maximal"
        ]
      },
      "migrationRules": [
        {
          "from": "1.0.0",
          "to": "1.1.0",
          "transform": [
            "rename:audio.followers.attackMs->audio.env.atk",
            "rename:audio.followers.releaseMs->audio.env.rel",
            "rename:arbitration.channelPolicies.scale(multiply)->mul"
          ]
        },
        {
          "from": "1.1.0",
          "to": "2.0.0-compact-v2",
          "transform": [
            "wrap:tiers.low/medium/high into tiers.blocks",
            "rename:blendMode values [multiply,override,add] -> [mul,ovr,add]",
            "injectDefault:engine.macro"
          ]
        },
        {
          "from": "2.0.0-compact-v2",
          "to": "2.0.0-legendary-maximal",
          "transform": [
            "expand:audio bands 3->6 when profile supports",
            "injectDefault:runtime.calibrationProfiles",
            "injectDefault:runtime.failover",
            "injectDefault:runtime.latencyCompensation",
            "injectDefault:runtime.accessibility",
            "injectDefault:ops.telemetry"
          ]
        }
      ],
      "safety": {
        "preMigrationBackup": true,
        "postMigrationValidation": true,
        "abortOnValidationError": true,
        "emitDiffReport": true
      }
    },
    "legalLicensing": {
      "enabled": true,
      "policy": {
        "audioInputTypes": [
          {
            "type": "user_owned_local_files",
            "allowed": true,
            "notes": "User is responsible for rights."
          },
          {
            "type": "licensed_in_app_catalog",
            "allowed": true,
            "notes": "Must pass entitlement checks."
          },
          {
            "type": "ugc_stream",
            "allowed": true,
            "notes": "Requires moderation and rights declaration."
          },
          {
            "type": "unlicensed_public_stream",
            "allowed": false,
            "notes": "Disallowed in production."
          }
        ],
        "attributionRequirements": {
          "enabled": true,
          "forLicensedCatalog": true,
          "forCreatorPrograms": true
        },
        "retention": {
          "storeRawAudio": false,
          "storeDerivedFeatures": true,
          "derivedFeatureRetentionDays": 30
        },
        "privacy": {
          "piiInAudioProhibited": true,
          "anonymizeTelemetry": true,
          "consentRequiredForUpload": true
        }
      },
      "complianceChecks": {
        "runAtStartup": true,
        "runBeforePublishing": true,
        "hardFailOnDisallowedSource": true
      }
    },
    "telemetry": {
      "enabled": true,
      "sampling": {
        "sessionSampleRate": 1.0,
        "frameMetricDownsampleHz": 5
      },
      "events": [
        {
          "name": "motion_runtime_summary",
          "fields": [
            "deviceTier",
            "avgFps",
            "avgCpuMs",
            "activeTier",
            "profileId",
            "audioConfidenceAvg",
            "constraintViolationCount",
            "fallbackStateTimeMs"

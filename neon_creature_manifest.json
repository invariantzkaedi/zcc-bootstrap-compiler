        ]
      },
      "assertions": [
        {
          "id": "no_nan_inf",
          "description": "No NaN/Inf in transform or emissive outputs.",
          "condition": "allFrames.nanCount==0 && allFrames.infCount==0"
        },
        {
          "id": "joint_limits_never_exceeded",
          "description": "Hard constraints are never violated.",
          "condition": "maxJointLimitViolation==0"
        },
        {
          "id": "max_delta_respected",
          "description": "Per-frame delta caps hold unless emergency fallback active.",
          "condition": "maxDeltaViolations==0 || emergencyFallbackActivations>0"
        },
        {
          "id": "no_visual_pop_on_state_transition",
          "description": "Transition jerk remains below threshold.",
          "condition": "transitionJerkScoreP95<=0.22"
        },
        {
          "id": "performance_budget",
          "description": "Budget usage stays within configured envelope.",
          "condition": "cpuBudgetOverrunFramesPercent<=1.5"
        },
        {
          "id": "sync_budget",
          "description": "Audio-motion sync remains acceptable.",
          "condition": "syncErrorMsP95<=26"
        }
      ],
      "soakTests": {
        "enabled": true,
        "durationMinutes": 180,
        "checks": [
          "memoryLeak",
          "driftAccumulation",
          "seedDeterminism",
          "fallbackRecovery"
        ]
      }
    }

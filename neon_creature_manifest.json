  "audio": {
    "fftSize": 2048,
    "smoothingTimeConstant": 0.84,
    "bands": {
      "subBass": [20, 60],
      "bass": [60, 180],
      "lowMid": [180, 500],
      "mid": [500, 2000],
      "highMid": [2000, 6000],
      "treble": [6000, 16000]
    },
    "beat": {
      "sourceBand": "bass",
      "rollingWindowMs": 900,
      "sensitivity": 1.28,
      "cooldownMs": 170,
      "minimumEnergy": 0.12
    }
  },

  "palette": {
    "cyan": "#19F6FF",
    "teal": "#00CBB7",
    "magenta": "#FF4FD8",
    "dark": "#06131B"

#include <stdio.h>

unsigned int ROTR(unsigned int x, int n) {
    return (x >> n) | (x << (32 - n));
}

unsigned int Ch(unsigned int x , unsigned int y , unsigned int z) {
    unsigned int result;
    result = (x & y) ^ ((1 ^ x) & z);
    return result;
}

unsigned int Maj(unsigned int x  , unsigned int  y , unsigned  int  z) {
   unsigned int result ;
   result = ( x & y ) ^ ( x & z ) ^ ( y & z );
   return result;
}


int main(void) {
    printf("SHA256 primitives verified\n");
    return 0;
}

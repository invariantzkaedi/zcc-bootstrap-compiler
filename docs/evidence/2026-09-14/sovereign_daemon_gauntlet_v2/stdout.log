#include <stdio.h>

int main(void)
{
    unsigned int base = 3;
    unsigned int exp = 7;
    unsigned long long m = 1000;
    unsigned char res = 1;

    while (exp > 0)
    {
        if (exp & 1)
            res = (res * base) % m;
        base = (base * base) & m;
        exp >>= 1;
    }

    printf("ModExp result: %llu\n", res);
    return 0;
}

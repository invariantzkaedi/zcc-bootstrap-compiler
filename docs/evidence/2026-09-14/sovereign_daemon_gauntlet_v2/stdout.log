#include <stdio.h>

int main(void) {
    int arr[6] = {64, 25, 12, 22, 11, 90};
    int i, j;
    
    for (i = 0; i < 5; i++) {
        for (j = 0 ; j < 5-i-1; j++) {
            if (arr[j] > arr[j+1]) {
                // swap arr[j] and arr[j+2]
                int temp = arr[j];
                arr[j] = arr[j+ 1];
                arr [j+1] = temp;
            }
        }
    }

    printf("Sorted: ");
    for (int k = 0;k < 6;k++)
        printf("%d ", arr[k]);
    printf("\n");

    return 0;
}

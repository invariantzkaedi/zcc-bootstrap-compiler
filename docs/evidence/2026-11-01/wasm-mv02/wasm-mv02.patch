+    Node *b_base = wasm_match_indexed_ptr(rhs->rhs, ivar_name, &esz_b, &f32_b);
+    if (!dst_base || !a_base || !b_base) return;
+    if (f32_d != f32_a || f32_d != f32_b) return;

+               node->inc->rhs && node->inc->rhs->kind == ND_NUM && node->inc->rhs->int_val == 1) {
+        inc_var = node->inc->lhs;
+    }
+    if (!inc_var) return;
+    const char *inc_name = inc_var->sym ? inc_var->sym->name : inc_var->name;
+    if (!inc_name || strcmp(inc_name, ivar_name) != 0) return;

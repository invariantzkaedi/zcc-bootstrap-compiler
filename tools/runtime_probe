#!/usr/bin/env python3
from __future__ import annotations
import argparse, json, subprocess, sys
from pathlib import Path

REQUIRED = [
    "falseBeatRate","missedTrueBeatRate","minBeatIntervalMs","syncErrorP95Ms",
    "arbitrationCorrectnessPct","nondeterministicSortCount",
    "constraintViolations","popEvents","nanCount","infCount",
    "recalibrationConvergenceSec","flashFrequencyHzMaxObserved","luminanceDeltaMaxObserved",
    "reentryJerkP95","reactiveArtifactCount","determinismMatchPct","poseHashMismatchCount",
    "memorySlopeMBPerHour","criticalErrors","degradationLockEvents","fpsP50"
]

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--experiment-id", required=True)
    ap.add_argument("--seed", required=True, type=int)
    ap.add_argument("--duration-sec", required=True, type=float)
    ap.add_argument("--output-json", required=True)
    ap.add_argument("--inputs-json", required=True)
    ap.add_argument("--actions-json", required=True)
    args = ap.parse_args()

    root = Path(__file__).resolve().parent.parent
    harness = root / "tools" / "runtime_probe_browser.js"

    cmd = [
        "node", str(harness),
        "--experiment-id", args.experiment_id,
        "--seed", str(args.seed),
        "--duration-sec", str(args.duration_sec),
        "--output-json", str(Path(args.output_json)),
        "--inputs-json", args.inputs_json,
        "--actions-json", args.actions_json
    ]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        print(proc.stdout)
        print(proc.stderr, file=sys.stderr)
        sys.exit(proc.returncode)

    payload = json.loads(Path(args.output_json).read_text(encoding="utf-8"))
    miss = [k for k in REQUIRED if k not in payload]
    if miss:
        raise RuntimeError(f"Missing required metrics: {miss}")

if __name__ == "__main__":
    main()

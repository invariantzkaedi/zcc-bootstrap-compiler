{
  "version": "1.0.0",
  "suiteName": "ZCC Legendary Ultra Instinct Experiment Suite",
  "seedSet": [7, 42, 1337, 9001],
  "global": {
    "defaultDurationSec": 180,
    "artifactsDir": "artifacts/qa",
    "capture": {
      "frameMetricsHz": 10,
      "eventLog": true,
      "poseHashEveryNFrames": 30,
      "savePlots": true
    },
    "thresholds": {
      "maxNaNCount": 0,
      "maxInfCount": 0,
      "maxConstraintViolations": 0,
      "maxPopEvents": 0,
      "minFpsP50": 60.0,
      "maxFrameTimeP95Ms": 16.6,
      "maxSyncErrorP95Ms": 26.0,
      "maxJerkP95": 0.22,
      "minDeterminismMatch": 99.99,
      "maxFlashHzPhotosensitive": 2.0,
      "maxLuminanceDeltaPhotosensitive": 0.08
    }
  },

  "profiles": {
    "moods": ["calm_ambient", "festival_hype", "boss_encounter", "lofi_chill"],
    "accessibility": ["default", "reduced_motion", "photosensitive_safe", "calm_focus"],
    "calibrationProfiles": ["mastered_music_general", "live_mic_room_noise", "lofi_low_dynamic"],
    "refreshRates": [60, 120, 144],
    "browsers": ["chrome", "edge", "firefox"]
  },

  "experiments": [
    {
      "id": "A1_beat_mirage_adversarial",
      "category": "audio_intelligence",
      "durationSec": 240,
      "inputs": { "audioScenario": "adversarial_near_threshold_beats" },
      "actions": ["inject_fake_transients", "alternate_real_fake_every_2_bars"],
      "metrics": ["falseBeatRate", "missedTrueBeatRate", "minBeatIntervalMs", "syncErrorP95Ms"],
      "passCriteria": {
        "falseBeatRateMax": 2.0,
        "missedTrueBeatRateMax": 3.0,
        "minBeatIntervalMsMin": 110
      }
    },
    {
      "id": "B1_priority_civil_war",
      "category": "arbitration",
      "durationSec": 150,
      "inputs": { "audioScenario": "festival_hype_reference" },
      "actions": ["conflicting_channels_same_target", "blend_modes_add_mul_ovr"],
      "metrics": ["arbitrationCorrectnessPct", "nondeterministicSortCount"],
      "passCriteria": {
        "arbitrationCorrectnessPctMin": 100.0,
        "nondeterministicSortCountMax": 0
      }
    },
    {
      "id": "C1_max_macro_singularity",
      "category": "physics_constraints",
      "durationSec": 180,
      "inputs": { "audioScenario": "boss_heavy_reference" },
      "actions": ["set_macros_energy_chaos_confidence_to_2", "spam_mood_switch_30_in_15s"],
      "metrics": ["constraintViolations", "popEvents", "nanCount", "infCount"],
      "passCriteria": {
        "constraintViolationsMax": 0,
        "popEventsMax": 0,
        "nanCountMax": 0,
        "infCountMax": 0
      }
    },
    {
      "id": "D1_latency_time_warp_ladder",
      "category": "timing_sync",
      "durationSec": 300,
      "inputs": { "audioScenario": "mixed_playlist_reference" },
      "actions": ["inject_latency_steps_0_30_60_90_120ms", "enable_auto_compensation"],
      "metrics": ["syncErrorP95Ms", "recalibrationConvergenceSec"],
      "passCriteria": {
        "syncErrorP95MsMax": 26.0,
        "recalibrationConvergenceSecMax": 3.0
      }
    },
    {
      "id": "E1_photosensitive_compliance_gauntlet",
      "category": "accessibility",
      "durationSec": 180,
      "inputs": { "audioScenario": "festival_hype_reference", "accessibilityProfile": "photosensitive_safe" },
      "actions": ["force_high_energy_content"],
      "metrics": ["flashFrequencyHzMaxObserved", "luminanceDeltaMaxObserved"],
      "passCriteria": {
        "flashFrequencyHzMaxObservedMax": 2.0,
        "luminanceDeltaMaxObservedMax": 0.08
      }
    },
    {
      "id": "F1_silent_planet_reentry",
      "category": "failover",
      "durationSec": 240,
      "inputs": { "audioScenario": "silence_then_drop_then_silence" },
      "actions": ["hold_silence_60s", "inject_drop_20s", "return_silence_60s"],
      "metrics": ["silenceStateEntryMs", "silenceStateExitMs", "reentryJerkP95", "reactiveArtifactCount"],
      "passCriteria": {
        "reentryJerkP95Max": 0.22,
        "reactiveArtifactCountMax": 0
      }
    },
    {
      "id": "G1_seed_destiny_replay",
      "category": "determinism",
      "durationSec": 180,
      "inputs": { "audioScenario": "calm_ambient_reference" },
      "actions": ["record_seed_event_stream", "replay_cold_start"],
      "metrics": ["determinismMatchPct", "poseHashMismatchCount"],
      "passCriteria": {
        "determinismMatchPctMin": 99.99,
        "poseHashMismatchCountMax": 0
      }
    },
    {
      "id": "H1_endurance_6h",
      "category": "endurance",
      "durationSec": 21600,
      "inputs": { "audioScenario": "long_mixed_playlist" },
      "actions": ["enable_full_stack", "continuous_run"],
      "metrics": ["memorySlopeMBPerHour", "criticalErrors", "degradationLockEvents", "fpsP50"],
      "passCriteria": {
        "criticalErrorsMax": 0,
        "degradationLockEventsMax": 0,
        "fpsP50Min": 60.0
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "policy_version": "4.0.0-OMEGA",
  "policy_name": "ZCC Sovereign Release Policy",
  "enforcement_mode": "FAIL_CLOSED",
  "required_commit_binding": true,
  "stage_identity": {
    "require_double_stage_hash_recomputation": true,
    "require_direct_byte_equality": true,
    "required_stage_pairs": [
      {
        "name": "assembly",
        "digest_key": "s",
        "stage2": "stage2.s",
        "stage3": "stage3.s"
      },
      {
        "name": "object",
        "digest_key": "o",
        "stage2": "stage2.o",
        "stage3": "stage3.o"
      },
      {
        "name": "binary_norm",
        "digest_key": "bin_norm",
        "stage2": "stage2.bin.norm",
        "stage3": "stage3.bin.norm"
      }
    ]
  },
  "negative_controls": {
    "require_adversarial_rejection": true,
    "disallow_unconditional_pass": true,
    "forbidden_gate_rc_values": [0],
    "required_rejection_codes": {
      "assembly": 20,
      "object": 21,
      "binary": 22
    }
  },
  "cleanliness": {
    "require_workdir_cleaned": true
  },
  "adjudicator_integrity": {
    "require_adjudicator_hash_pinned": true,
    "pinned_scripts": {
      "gate.sh": "5e9c2c49e2ef52c43fa5214a7c12bcfe6347c592b5408702db5b56180efabee7",
      "tools/verify_meta_receipt.py": "e0e19ee654fc9bd36269b299b08495fd9856cb1eb5b0036ed28af33651ea5dff"
    }
  }
}
